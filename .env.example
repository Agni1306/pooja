# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PostgreSQL connection string for Prisma ORM
# Example local connection: postgresql://postgres:postgres@localhost:5432/digithela?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/digithela?schema=public"

# Express Backend Server Configuration
PORT=3000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# JWT Authentication (replace with a strong random secret in .env)
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"
ADMIN_REGISTRATION_KEY="REPLACE_WITH_ADMIN_INVITE_KEY"

# File Uploads
UPLOAD_DIR="uploads"

# Optional Cloudinary Configuration (leave blank to use local disk uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

